# 兼容方式示例：公开文档默认以 config.json 为主。
# 如果你更习惯用环境变量，也可以参考下面这些字段。

# 必填：文本模型 API Key
OPENAI_API_KEY=your_api_key_here

# 必填：文本模型接口地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 必填：目录分析链路使用的模型
OPENAI_ANALYSIS_MODEL=gpt-5.2

# 必填：整理规划链路使用的模型
OPENAI_ORGANIZER_MODEL=gpt-5.2

# 可选：是否开启图片理解
IMAGE_ANALYSIS_ENABLED=false

# 可选：如果开启图片理解且不复用文本模型，可单独配置
IMAGE_ANALYSIS_BASE_URL=
IMAGE_ANALYSIS_API_KEY=
IMAGE_ANALYSIS_MODEL=
